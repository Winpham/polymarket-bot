# Required
DATABASE_URL=postgres://bot:bot@localhost:5432/polymarket
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
OPENAI_API_KEY=your_openai_api_key

# Optional (defaults shown)
# SCAN_INTERVAL_MINS=30
# NEWS_SCAN_INTERVAL_MINS=10
# NEWS_ENABLED=false
# SLIPPAGE_PCT=0.01
# FEE_PCT=0.02
# MIN_VOLUME=1000.0
# MIN_BOOK_DEPTH=200.0
# KELLY_FRACTION=0.25
# MAX_DAYS_TO_EXPIRY=14
# MAX_LLM_CANDIDATES=1
# MAX_MODEL_CANDIDATES=15
# MIN_EFFECTIVE_EDGE=0.08
# LLM_MODEL=gpt-4o
# HEARTBEAT_INTERVAL_MINS=60
# CONSENSUS_AGENTS=2
# CALIBRATION_MIN_SAMPLES=20
# MAX_MARKETS_FETCH=1000
# MIN_PRICE=0.03
# MAX_PRICE=0.97
# STRATEGY_BANKROLL=300.0
# STRATEGIES=aggressive,balanced,conservative
#
# --- Per-strategy tuning (override any individual param) ---
# AGGRESSIVE_KELLY_FRACTION=0.50
# AGGRESSIVE_MIN_EDGE=0.05
# AGGRESSIVE_MIN_CONFIDENCE=0.40
# AGGRESSIVE_MAX_SIGNALS=10
# AGGRESSIVE_MIN_BET=5.0
#
# BALANCED_KELLY_FRACTION=0.25
# BALANCED_MIN_EDGE=0.06
# BALANCED_MIN_CONFIDENCE=0.40
# BALANCED_MAX_SIGNALS=5
# BALANCED_MIN_BET=5.0
#
# CONSERVATIVE_KELLY_FRACTION=0.15
# CONSERVATIVE_MIN_EDGE=0.08
# CONSERVATIVE_MIN_CONFIDENCE=0.50
# CONSERVATIVE_MAX_SIGNALS=3
# CONSERVATIVE_MIN_BET=15.0
# STOP_LOSS_PCT=999.0
# EXIT_DAYS_BEFORE_EXPIRY=0
# MODEL_SIDECAR_URL=
# COPY_TRADE_ENABLED=false
# COPY_TRADE_INTERVAL_MINS=5

# --- Consensus engine (copy-trading-bot): auto-track top-N + consensus alerts ---
# TRACK_ENABLED=true               # master switch for auto-tracking + consensus
# TRACK_TOP_N=40                   # top traders per period to track (cap 50)
# TRACK_PERIODS=WEEK,MONTH         # leaderboard periods to union (DAY,WEEK,MONTH,ALL)
# TRACK_REFRESH_MINS=60            # how often to resync the tracked universe
# TRACK_DROP_GRACE=6               # refresh cycles absent before deactivating a trader
# CONSENSUS_INTERVAL_MINS=2        # how often to run consensus detection
# CONSENSUS_WINDOW_HOURS=48        # rolling window of trader activity considered
# MIN_BACKERS=3                    # min distinct one-sided backers
# MAX_OPPOSERS=1                   # max distinct one-sided opposers tolerated
# MAX_PRICE_STD=0.10               # max entry-price std-dev (price coherence)
# MAX_AGE_MINS=2880                # max age (min) of the freshest backer fill
# STRONG_NET=4                     # net-trader count for the STRONG (push) tier
# ELITE_NET=6                      # net-trader count for the ELITE (priority) tier
# ELITE_RANK=10                    # leaderboard rank counting as "elite"
# CONSENSUS_INCLUDE_SPORTS=true    # include sports/esports in consensus alerts (strict strategy)
# CONSENSUS_REALERT_NET_DELTA=2    # re-alert only when net grows by this many traders
# CONSENSUS_STRATEGIES=            # comma-list of portfolio strategies to run (empty = all 10).
#   Portfolio (forward-tested simultaneously; only `strict` pushes Telegram, rest track silently):
#   strict, loose, fresh2h, longshot, favorite, sports_only, nonsports, elite_gated, whales, count

RUST_LOG=info
