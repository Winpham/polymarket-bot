NTFY_TOPIC=MLLN2OO3LM3IJJURDXEFQCBFOBE4HB3G
NTFY_SERVER=https://ntfy.sh

# Forward 29-feature accrual for the market_resid arm (Phase 1; safe, additive,
# free public data, no money). Trains the price-free model on our own strict-fired
# population. Takes effect when the new binary deploys.
MARKET_FEATURE_LOG=true

# 2026-07-02 Fable run (Item 0): capture real executable asks (paper realizability data;
# additive, flag-gated code shipped in 8e59b68; revert = delete this line + recreate stack)
CAPTURE_ENTRY_ASK=true

# 2026-07-02 decision-time ask capture (feat/entry-ask-decision): bind the ask to the
# first-price snapshot so entry_ask_mid == initial_market_price (mig 032). Own budget so
# a lagged backlog can't starve decision-time captures; realized ROI counts captures
# within this many seconds of first detection. Compose defaults (40/900) shown explicitly.
ENTRY_ASK_DECISION_MAX_PER_CYCLE=40
REALIZED_DECISION_LAG_SECS=900.0

# 2026-07-02 deep-leaderboard ingestion (feat/deep-leaderboard, merged 5c58dc0):
# widen CAPTURE to the top-200 via offset pagination. Scale-gate measured: 200
# traders @ concurrency 8 = 8.5s / 0 data-api 429s (vs ~120s cycle). The voter set
# is UNCHANGED — TRACK_CONSENSUS_RANK_CUTOFF defaults to 40 (= today's top-40), so
# ranks 41-200 are captured/profiled but do NOT vote in consensus (byte-for-byte
# non-regressive). Revert = remove this line (falls back to top-40 capture).
TRACK_DEPTH=200

# 2026-07-02 deep-pool edge run (feat/deep-edge, REPORT-DEEP-EDGE.md): register the
# SILENT trust/cross-cohort/tail arms + hourly trust map (never alert; strict is
# byte-for-byte unchanged) and forward-track the re-tuned selectivity variant.
# EARN_DEEP_SHARPS stays OFF (report-only) — flipping it is a deliberate call once
# the board shows a "promotable" deep sharp. Revert = delete these two lines.
CONSENSUS_TRUST_ARMS=true
CONSENSUS_RETUNED=4,5,8

# Dense early-life capture ON — measure lambda (CLV) for the favorite edge (D22 next-dollar; forge dominant move, 2026-07-03)
DENSE_CAPTURE=true

# Proven-trader router arm + follow-set re-scorer (PREREG 2026-07-04, paper-only,
# alerting OFF; fail-closed on an empty follow-set). Flipped on at build time 2026-07-04.
PROVEN_ROUTER=true
DENSE_STRATEGIES=strict,favorite,elite_fresh_fav,proven_router

# Capture-hardening (2026-07-04, review-approved): survivorship de-bias + follow-set fast lane.
CAPTURE_DROPPED=true
HOT_LANE=true

# Live CLOB price tape (migration 040) — accrual ON 2026-07-07
LIVE_TAPE=true
LIVE_TAPE_MAX_SUBS=200

# Cycle-7 WIN #3 (human-approved 2026-07-08): narrow paper ledger to the frozen STANDARD.
# Stops appending the ~14 net-negative experimental arms. Arms stay REGISTERED + SCORED
# (resolve_consensus_signal runs for all) so the belief-blind guard comparison set is intact.
LEDGER_STRATEGIES=favorite,elite_fresh_fav

# Weather shadow arm — PAPER capture (Weather Edge Refinement, 2026-07-11). weather_fav/weather_fav_liq
# score the daily-temperature wider-eligibility book (rank<=250) + capture entry_ask forward. alerting=false.
CONSENSUS_WEATHER_ARM=true
