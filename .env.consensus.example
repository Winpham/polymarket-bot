# Copy to .env.consensus and fill in. The consensus bot is ALERT/PAPER ONLY —
# no wallet, no private key, no funds. ntfy-only setup: alerts buzz your phone
# via your EXISTING brainstem ntfy channel; no Telegram bot needed.

# Your ntfy topic — the SAME one brainstem uses.
# Find it (do NOT share it; it's a 160-bit secret):
#   python3 -c "import json;print(json.load(open('$HOME/.brainstem/notify.config.json'))['ntfy']['topic'])"
NTFY_TOPIC=

# ntfy server (leave default unless brainstem uses a self-hosted one):
NTFY_SERVER=https://ntfy.sh

# --- Optional: Telegram (leave blank for ntfy-only). If set, adds the
#     interactive /consensus scoreboard + commands in addition to ntfy. ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Silent cross-check ARMS (default OFF). Each runs only when its flag is ON
#     *and* its model file (see model/README.md) exists; emitted picks are silent
#     (never alert) and judged by the belief-blind gate in the *experimental*
#     family. The gate — not us — decides if an arm has edge. Enable deliberately
#     once a model is trained. ---
# CONSENSUS_ARM_LOGIT=true     # consensus-native logistic (model/consensus_win.json)
# CONSENSUS_ARM_ENS=true       # consensus-native XGBoost ensemble (model/consensus_ens.json)
# CONSENSUS_ARM_MARKET=true    # imported market model (model/xgb_model.json) → market_ml/market_veto
# CONSENSUS_ARM_BAYES=true     # Bayesian anchor (needs no model file; uses live CLOB mid)
# CONSENSUS_ARM_RESID=true     # price-LEVEL-free residual (model/market_resid.json + .resid.json) → market_resid
# CONSENSUS_ML_MARGIN=0.0      # edge the LEGACY ML arms must clear: p_win − price > margin
# MARKET_RESID_MARGIN=0.0      # market_resid's OWN knob: p_cons − band_rate > margin (its .meta.json suggested_margin)
# CONSENSUS_BAYES_MARGIN=0.0   # edge bayes must clear: posterior − mid > margin
# MARKET_ML_TRAINED_THROUGH=   # RFC3339 cutoff for the market model's forward guard
# MARKET_RESID_TRAINED_THROUGH=  # override for market_resid (else its .meta.json trained_through)

# --- market_resid accrual + enable (price-LEVEL-free residual; the no-money edge test) ---
#     "price-LEVEL-free" = the booster never splits on the price-LEVEL features
#     {yes_price, price_change_1d, price_change_1w}; enforced at TRAIN and re-checked
#     in Rust before the arm loads. It is NOT price-free: the price-SHAPE features
#     (momentum/volatility/rsi) remain, so a surplus is only trusted if it survives
#     the price-SHAPE ablation (train_market_resid.py --price-free-level shape).
# 1. ACCRUE: turn the forward 29-feature log ON so the model can be trained on the
#    bot's OWN survivorship-free strict-fired population (no backtest needed):
MARKET_FEATURE_LOG=true        # log YES-oriented features for every strict-fired market
# 2. When >=30 distinct events have resolved:
#      SELECT COUNT(DISTINCT COALESCE(cs.event_slug,cs.condition_id))
#      FROM market_feature_log mfl JOIN consensus_signals cs ON cs.id=mfl.signal_id
#      WHERE cs.strategy='strict' AND cs.resolved;
#    train the forward model + set MARKET_RESID_MARGIN to its suggested calRMSE:
#      DATABASE_URL=... python3 scripts/train_market_resid.py --source forward --out-dir model
# 3. ENABLE silently (still no alerts): CONSENSUS_ARM_RESID=true and read its
#    promotion_verdict on the board. PROMOTABLE only via the gate (corrected lower
#    bound > margin over >=30 events). A clean null is an honest verdict — not a bug.

# --- L1 polling (sensible defaults baked in; override only to tune) ---
# CONSENSUS_INTERVAL_MINS=1    # every-minute cadence
# CONSENSUS_INCREMENTAL=true   # delta ingestion + off-network book assembly

# --- Trader profiles (RUN-TRADER-PROFILES; default-OFF + non-regressive) ---
# The durable trader_fills archive captures continuously regardless of these
# flags. Earned-trust verdicts (/trader, /trustedtraders, board trust table)
# build forward and read INDETERMINATE until a trader has >=30 resolved events.
# CONSENSUS_MAX_CONCURRENCY=8       # cap concurrent data-api polls (raise only when 429s ~ 0)
# TRADER_FILLS_RESOLVE_PER_CYCLE=200 # max trader_fills conditions resolved per housekeeping cycle
# TRADER_FILLS_RETENTION_DAYS=0     # 0 = keep-all (durable archive); >0 prunes older fills
# CONSENSUS_TRUST_ARMS=true         # register the silent trust_weighted/trusted_only arms (experimental family)
# TRUST_REFRESH_MINS=60             # how often to refresh the cached earned-trust map
# CONSENSUS_BOOKS_FROM_FILLS=true   # build consensus books from the durable archive (dual-written;
#                                   # flip only after capture is proven; instant rollback by unsetting)
