# Copy to .env.consensus and fill in. The consensus bot is ALERT/PAPER ONLY —
# no wallet, no private key, no funds. ntfy-only setup: alerts buzz your phone
# via your EXISTING brainstem ntfy channel; no Telegram bot needed.

# Your ntfy topic — the SAME one brainstem uses.
# Find it (do NOT share it; it's a 160-bit secret):
#   python3 -c "import json;print(json.load(open('$HOME/.brainstem/notify.config.json'))['ntfy']['topic'])"
NTFY_TOPIC=

# ntfy server (leave default unless brainstem uses a self-hosted one):
NTFY_SERVER=https://ntfy.sh

# --- Optional: Telegram (leave blank for ntfy-only). If set, adds the
#     interactive /consensus scoreboard + commands in addition to ntfy. ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
