# Copy to .env.consensus and fill in. The consensus bot is ALERT/PAPER ONLY —
# it needs NO wallet, NO private key, NO funds. Only a Telegram bot + your chat id.

# From @BotFather (/newbot) — looks like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id (see DEPLOY.md step 2). Owner-only commands key off this.
TELEGRAM_CHAT_ID=
