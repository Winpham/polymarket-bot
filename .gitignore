/target
.env
.venv
portfolio_state.json
# Trained model artifacts are local/baked-at-build, not committed — but keep the
# dir (placeholder + README) tracked so a fresh clone builds (Dockerfile bakes it).
/model/*
!/model/.gitkeep
!/model/README.md
__pycache__/
*.pyc
CHANGELOG.gen
.envrc
tmp/

# consensus deploy secrets
.env.consensus
.env.consensus.smoke

# consensus autoupdate runtime state
.last_built_commit
.autoupdate.log
.autoupdate.out
.autoupdate.err

# backups + backup log (local-only)
backups/
.backup.log
