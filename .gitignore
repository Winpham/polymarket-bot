/target
.env
.venv
portfolio_state.json
# Trained model artifacts are local/baked-at-build, not committed — but keep the
# dir (placeholder + README) tracked so a fresh clone builds (Dockerfile bakes it).
/model/*
!/model/.gitkeep
!/model/README.md
__pycache__/
*.pyc
CHANGELOG.gen
.envrc
tmp/

# consensus deploy secrets
.env.consensus
.env.consensus.smoke

# consensus autoupdate runtime state
.last_built_commit
.autoupdate.log
.autoupdate.out
.autoupdate.err

# backups + backup log (local-only)
backups/
.backup.log

# local coordination worktrees (never committed)
wt/

# live-ingestion (migration 040) probe intermediates — large/regenerable
reports/tape_*.jsonl
reports/*.jsonl.assets.json
reports/token_map*.json
reports/capture.log
reports/escalate.log

# Local Parquet archive (hot/cold split) — the durable copy lives in R2, not git.
/polymarket-archive/
archive/
