# Builds the copy-trading-bot (consensus engine) from source inside Docker, so
# deploying needs only Docker — no local Rust toolchain. Multi-stage: a Rust
# builder compiles the release binary, then a tiny Debian runtime runs it.
# TLS is rustls (no system OpenSSL needed); migrations are embedded at compile.
# Builder and runtime are BOTH Debian bookworm so glibc versions match (a
# `rust:1-slim` trixie builder + bookworm runtime fails with GLIBC_2.38 not found).
FROM rust:1-bookworm AS builder
WORKDIR /src
# mimalloc (global allocator) compiles C; pkg-config for build hygiene.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential pkg-config \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release -p copy-trading-bot

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/copy-trading-bot /usr/local/bin/copy-trading-bot
# Bake the model/ dir so the cross-check arms can load their artifacts at the
# config-default `model/...` paths (CWD = /app). Empty unless models were trained
# into model/ before the build — arms are default-OFF and no-op without a file.
COPY --from=builder /src/model /app/model
ENTRYPOINT ["copy-trading-bot"]
